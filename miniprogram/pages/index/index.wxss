.page { min-height: 100vh; background: #eaf7ff; padding: 24rpx 24rpx 56rpx; box-sizing: border-box; }
.hero { min-height: 276rpx; padding: 38rpx 32rpx; border-radius: 32rpx; color: #fff; display: flex; align-items: center; gap: 26rpx; background: linear-gradient(135deg, #168ee8 0%, #55bdf6 58%, #79ccfa 100%); box-shadow: 0 20rpx 50rpx rgba(32, 139, 211, .22); }
.avatar { flex: 0 0 132rpx; width: 132rpx; height: 132rpx; border-radius: 50%; border: 5rpx solid rgba(255,255,255,.72); box-shadow: 0 8rpx 22rpx rgba(0,80,146,.2); }
.hero-copy { min-width: 0; display: flex; flex-direction: column; }.eyebrow { font-size: 20rpx; letter-spacing: 2rpx; color: #dff4ff; font-weight: 700; }.title { margin-top: 6rpx; font-size: 42rpx; line-height: 1.2; font-weight: 800; }.intro { margin-top: 10rpx; color: #edf9ff; font-size: 23rpx; line-height: 1.55; }
.privacy-note { padding: 20rpx 12rpx; color: #46728a; font-size: 23rpx; text-align: center; }.card { margin-top: 18rpx; padding: 30rpx; background: #fff; border: 1rpx solid #d5eaf6; border-radius: 26rpx; box-shadow: 0 12rpx 28rpx rgba(63, 139, 182, .08); }.section-label { color: #58819a; font-size: 22rpx; font-weight: 700; }.second-label { display: block; margin-top: 22rpx; }.segmented { margin-top: 12rpx; display: flex; gap: 8rpx; padding: 7rpx; border-radius: 16rpx; background: #e8f5fc; }.segmented.short { width: 280rpx; }.segment { flex: 1; padding: 14rpx 8rpx; color: #5c7d91; border-radius: 12rpx; text-align: center; font-size: 25rpx; font-weight: 700; }.segment.active { color: #1373b4; background: #fff; box-shadow: 0 3rpx 10rpx rgba(38, 120, 167, .14); }
.section-heading { display: flex; gap: 18rpx; align-items: flex-start; margin-bottom: 22rpx; }.section-heading > text { display: grid; place-items: center; flex: 0 0 38rpx; width: 38rpx; height: 38rpx; color: #146eaa; background: #dff3ff; border-radius: 11rpx; font-size: 20rpx; font-weight: 800; }.section-heading view { display: flex; flex-direction: column; }.heading-title { font-size: 28rpx; font-weight: 800; }.heading-help { margin-top: 4rpx; color: #7893a4; font-size: 22rpx; }.field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }.field { position: relative; min-height: 144rpx; padding: 20rpx; border: 1rpx solid #d7e8f2; border-radius: 18rpx; background: #fcfeff; box-sizing: border-box; display: flex; flex-direction: column; }.field > text:first-child { color: #30546b; font-size: 24rpx; font-weight: 700; }.field-help { min-height: 30rpx; margin-top: 3rpx; color: #86a0af; font-size: 19rpx; }.field input { width: 100%; margin-top: 6rpx; padding-right: 30rpx; color: #153b53; box-sizing: border-box; font-size: 30rpx; font-weight: 700; }.unit { position: absolute; right: 18rpx; bottom: 20rpx; color: #82a0af; font-size: 20rpx; }.bmi { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 18rpx 20rpx; color: #4f7387; background: #eff9fe; border-radius: 16rpx; font-size: 23rpx; }.bmi text:last-child { color: #126ea9; font-size: 28rpx; font-weight: 800; }
.knowledge { display: flex; justify-content: space-between; gap: 16rpx; align-items: center; margin-top: 20rpx; padding: 20rpx; border: 1rpx solid #d6eafb; background: #f3faff; border-radius: 18rpx; }.knowledge > view:first-child { display: flex; flex-direction: column; }.knowledge-title { color: #2f5f7b; font-size: 24rpx; font-weight: 700; }.knowledge-help { margin-top: 3rpx; color: #7896a8; font-size: 20rpx; }.knowledge-input { display: flex; align-items: center; width: 150rpx; padding: 8rpx 0; border-bottom: 2rpx solid #9ac8e5; color: #6e8da0; }.knowledge-input input { min-width: 0; text-align: right; color: #176fa8; font-size: 28rpx; font-weight: 700; }.actions { display: flex; gap: 14rpx; margin-top: 22rpx; }.ghost { flex: 1; padding: 10rpx; color: #2778a8; background: #eef8fe; border-radius: 15rpx; font-size: 24rpx; font-weight: 700; }
.result-card { margin-top: 20rpx; overflow: hidden; border-radius: 28rpx; background: #fff; border: 1rpx solid #cce8f6; box-shadow: 0 14rpx 30rpx rgba(64, 142, 183, .1); }.result-top { display: flex; flex-direction: column; padding: 32rpx; color: #fff; background: linear-gradient(145deg, #147cc2, #43afea); }.result-kicker { color: #d9f4ff; font-size: 22rpx; letter-spacing: 1rpx; font-weight: 700; }.score-line { display: flex; align-items: baseline; gap: 12rpx; margin: 8rpx 0; }.score-line text:first-child { font-size: 84rpx; line-height: 1; letter-spacing: -4rpx; font-weight: 800; }.score-line text:last-child, .result-top > text:last-child { color: #e6f8ff; font-size: 23rpx; }.result-body { padding: 24rpx; }.stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }.stats view { min-height: 118rpx; padding: 17rpx; border: 1rpx solid #e0edf4; border-radius: 16rpx; background: #fbfdff; box-sizing: border-box; }.stats view > text:first-child, .stat-hint { display: block; color: #7792a3; font-size: 20rpx; }.stat-number { display: block; margin: 3rpx 0; color: #176fa8; font-size: 34rpx; font-weight: 800; }.detail-list { margin-top: 24rpx; }.detail-title { display: block; margin-bottom: 8rpx; color: #507286; font-size: 23rpx; font-weight: 800; }.detail-row { display: grid; grid-template-columns: 1fr auto auto; gap: 12rpx; padding: 16rpx 0; border-top: 1rpx dashed #dce8ef; color: #54778b; font-size: 21rpx; }.detail-row text:nth-child(2) { color: #7190a1; }.detail-row text:last-child { color: #1877ad; font-weight: 700; }.report-gate { display: flex; flex-direction: column; margin-top: 22rpx; padding: 24rpx; border-radius: 20rpx; background: #eef9ff; }.gate-title { color: #245e81; font-size: 27rpx; font-weight: 800; }.gate-copy { margin-top: 4rpx; color: #688a9f; font-size: 21rpx; }.pay-button { margin-top: 18rpx; color: #fff; background: linear-gradient(135deg, #1688d2, #46baf4); border-radius: 16rpx; font-size: 26rpx; font-weight: 700; }.footer { margin: 28rpx 20rpx 0; color: #7693a5; text-align: center; font-size: 21rpx; line-height: 1.6; }
