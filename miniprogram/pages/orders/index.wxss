.page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; box-sizing: border-box; background: #eaf7ff; }.hero { display: flex; flex-direction: column; gap: 10rpx; padding: 34rpx 30rpx; color: #fff; border-radius: 28rpx; background: linear-gradient(135deg, #168ee8, #63c1f5); }.hero text:first-child { font-size: 34rpx; font-weight: 800; }.hero text:last-child { color: #eaf8ff; font-size: 22rpx; line-height: 1.6; }.order-card { display: flex; flex-direction: column; gap: 14rpx; margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #d7eaf5; border-radius: 24rpx; background: #fff; color: #5d7d90; font-size: 23rpx; }.order-top, .row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.order-title { color: #285873; font-size: 27rpx; font-weight: 800; }.status { flex: 0 0 auto; padding: 5rpx 12rpx; border-radius: 10rpx; color: #28769d; background: #e8f6ff; font-size: 20rpx; }.status-delivered { color: #16835f; background: #e8faf3; }.status-refunded { color: #947141; background: #fff6e6; }.row text:first-child { color: #7d99a9; }.price { color: #167ab8; font-size: 30rpx; font-weight: 800; }.hint { padding-top: 12rpx; border-top: 1rpx solid #e4eff5; color: #7b94a3; font-size: 20rpx; line-height: 1.55; }.empty { display: flex; flex-direction: column; gap: 12rpx; margin-top: 18rpx; padding: 64rpx 30rpx; color: #7392a5; border-radius: 24rpx; background: #fff; text-align: center; font-size: 23rpx; }.empty text:first-child { color: #426d87; font-size: 27rpx; font-weight: 800; }.service-link { display: block; margin-top: 20rpx; padding: 18rpx; color: #1b78ad; border: 1rpx solid #b9def2; border-radius: 16rpx; background: #eff9ff; text-align: center; font-size: 23rpx; font-weight: 700; }
