.page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; box-sizing: border-box; background: #eaf7ff; }.hero { display: flex; flex-direction: column; padding: 36rpx 32rpx; color: #fff; border-radius: 30rpx; background: linear-gradient(135deg, #168ee8 0%, #55bdf6 70%, #7acef8 100%); box-shadow: 0 20rpx 50rpx rgba(32, 139, 211, .2); }.eyebrow { color: #dff4ff; font-size: 19rpx; letter-spacing: 1.5rpx; font-weight: 700; }.title { margin-top: 12rpx; font-size: 42rpx; font-weight: 800; }.subtitle, .category { margin-top: 7rpx; color: #edf9ff; font-size: 23rpx; }.hero-score { display: flex; align-items: baseline; gap: 12rpx; margin-top: 20rpx; }.hero-score text:first-child { font-size: 76rpx; line-height: 1; font-weight: 800; }.hero-score text:last-child { color: #e8f8ff; font-size: 24rpx; }.card { margin-top: 18rpx; padding: 28rpx; border: 1rpx solid #d7eaf5; border-radius: 25rpx; background: #fff; box-shadow: 0 12rpx 28rpx rgba(63, 139, 182, .07); }.section-title { display: block; color: #285873; font-size: 28rpx; font-weight: 800; }.section-copy { display: block; margin-top: 10rpx; color: #668596; font-size: 22rpx; line-height: 1.65; }.summary-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; margin-top: 20rpx; }.summary-grid view { min-height: 116rpx; padding: 16rpx; border: 1rpx solid #e1edf3; border-radius: 16rpx; background: #fbfdff; box-sizing: border-box; }.summary-grid text { display: block; color: #7893a3; font-size: 19rpx; }.summary-grid text:nth-child(2) { margin: 3rpx 0; color: #176fa8; font-size: 33rpx; font-weight: 800; }.process { display: flex; justify-content: space-between; margin-top: 16rpx; padding: 17rpx; color: #517488; border-radius: 15rpx; background: #f1faff; font-size: 22rpx; }.process text:last-child { color: #1376b1; font-weight: 800; }.priority-list { margin-top: 18rpx; }.priority-row, .target-row { padding: 17rpx 0; border-top: 1rpx dashed #dbe9ef; }.priority-row view, .target-row view { display: flex; justify-content: space-between; gap: 12rpx; color: #305871; font-size: 23rpx; font-weight: 700; }.priority-row view text:last-child, .target-row view text:last-child { color: #748f9f; font-size: 20rpx; font-weight: 400; }.priority-row > text, .target-copy { display: block; margin-top: 8rpx; color: #5f879d; font-size: 21rpx; line-height: 1.55; }.good-state { display: block; margin-top: 16rpx; color: #2c8a61; font-size: 22rpx; }.detail-head, .detail-row { display: grid; grid-template-columns: 1fr 100rpx 115rpx; gap: 8rpx; align-items: center; }.detail-head { margin-top: 18rpx; padding-bottom: 10rpx; color: #8098a7; font-size: 19rpx; }.detail-head text:not(:first-child), .detail-row > text { text-align: right; }.detail-row { padding: 16rpx 0; color: #4e7185; border-top: 1rpx dashed #dce8ef; font-size: 21rpx; }.detail-row view { display: flex; flex-direction: column; }.detail-row view text:first-child { color: #31566c; font-weight: 700; }.detail-row view text:last-child { margin-top: 3rpx; color: #8299a7; font-size: 19rpx; }.detail-row > text:last-child { color: #1778b0; font-weight: 700; }.notice { margin: 28rpx 10rpx 0; color: #6d8b9c; font-size: 20rpx; line-height: 1.65; text-align: center; }.contact { margin-top: 18rpx; padding: 10rpx 16rpx; color: #1b78ad; border: 1rpx solid #b9def2; border-radius: 14rpx; background: #fff; font-size: 22rpx; }
