.page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; box-sizing: border-box; background: #eaf7ff; }.hero { display: flex; flex-direction: column; gap: 10rpx; padding: 34rpx 30rpx; color: #fff; border-radius: 28rpx; background: linear-gradient(135deg, #168ee8, #63c1f5); }.hero text:first-child { font-size: 34rpx; font-weight: 800; }.hero text:last-child { color: #eaf8ff; font-size: 22rpx; line-height: 1.6; }.card { display: flex; flex-direction: column; gap: 13rpx; margin-top: 18rpx; padding: 28rpx; color: #5d7d90; border: 1rpx solid #d7eaf5; border-radius: 24rpx; background: #fff; font-size: 22rpx; line-height: 1.65; }.title { color: #285873; font-size: 27rpx; font-weight: 800; }.order-center { margin-top: 8rpx; padding: 10rpx 16rpx; color: #1b78ad; border: 1rpx solid #b9def2; border-radius: 14rpx; background: #eff9ff; font-size: 23rpx; font-weight: 700; text-align: center; }.contact { margin-top: 8rpx; padding: 10rpx 16rpx; color: #1b78ad; border: 1rpx solid #b9def2; border-radius: 14rpx; background: #eff9ff; font-size: 23rpx; }
